  "care_tips": [
    {
      "id": "power_off",
      "safety": true,
      "priority": "HIGH",
      "text": "Switch off the mains supply before cleaning or moving the stabilizer.",
      "why": "It carries mains voltage.",
      "trigger": {
        "always": true
      }
    },
    {
      "id": "no_opening",
      "safety": true,
      "priority": "HIGH",
      "text": "Don't open the stabilizer yourself; leave repairs to the brand's authorised service.",
      "why": "Inside there are live parts, and opening it can also end the warranty.",
      "trigger": {
        "always": true
      }
    },
    {
      "id": "right_rating",
      "priority": "HIGH",
      "text": "Use a stabilizer rated for the appliance it protects.",
      "why": "An undersized stabilizer overheats and gives poor protection.",
      "trigger": {
        "answers": {
          "rating": [
            "not_sure"
          ]
        }
      }
    },
    {
      "id": "air",
      "priority": "MEDIUM",
      "text": "Keep space around it for air to flow.",
      "why": "It warms up while working.",
      "trigger": {
        "answers": {
          "placement": [
            "closed"
          ]
        }
      }
    },
    {
      "id": "dust",
      "priority": "LOW",
      "text": "Keep it free of dust (switched off).",
      "why": "Dust traps heat.",
      "trigger": {
        "always": true
      }
    },
    {
      "id": "electrician",
      "priority": "MEDIUM",
      "text": "If it switches very often, ask an electrician or your supplier to check the supply.",
      "why": "Large swings strain it and your appliance.",
      "trigger": {
        "answers": {
          "clicking": [
            "often"
          ],
          "power_issues": [
            "often"
          ]
        }
      }
    },
    {
      "id": "early_signs",
      "priority": "HIGH",
      "text": "If it smells of burning or gets very hot, switch it off and contact the brand's service.",
      "why": "These can be signs of a dangerous fault.",
      "trigger": {
        "answers": {
          "symptoms": [
            "smell",
            "hum",
            "hot"
          ]
        }
      }
    }
  ],
  "reminders": [
    {
      "id": "check",
      "text": "Check the stabilizer's cable and plug, and dust it (switched off).",
